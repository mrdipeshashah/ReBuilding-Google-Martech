WITH base_events AS (
  SELECT
    -- standard GA4 date for partitioning/filtering
    PARSE_DATE('%Y%m%d', event_date) AS date,
    event_name,
    user_pseudo_id,
    -- Extracting session_id
    (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') AS session_id,
    -- Extracting GTM specific parameters
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'tag_name') AS tag_name,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'container_id') AS container_id,
    (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'container_version') AS container_version,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'tag_category') AS tag_category,
    -- This is your custom GTM timestamp string from the screenshot
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'hit_timestamp') AS gtm_hit_time
  FROM `enter.tablename_123456.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20240901' AND '20240930' -- Set your date range here
)

SELECT 
  date,
  event_name,
  LOWER(tag_name) AS tag_name,
  container_id,
  container_version,
  LOWER(tag_category) AS tag_category,
  -- We include min/max hit time to see the window when the tag was active on that day
  MIN(gtm_hit_time) AS first_hit_recorded,
  MAX(gtm_hit_time) AS last_hit_recorded,
  COUNT(*) AS event_count
FROM base_events
WHERE tag_name IS NOT NULL
  AND event_name NOT IN ('user_engagement','scroll','session_start','first_visit')
GROUP BY 1, 2, 3, 4, 5, 6
ORDER BY date DESC, event_count DESC
